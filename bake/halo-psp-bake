#!/bin/sh
# halo-psp-bake: the bake's command on Linux and macOS (halo-psp-bake.cmd on
# Windows). Finds a Python 3.9 to 3.14 and hands over to launcher.py, which
# sets up the bake's own environment on the first run and starts bake.py.
#   ./halo-psp-bake <Halo disc image or maps folder> <output folder> [options]
#
# Which Python: the bake's environment's own once it is made, then the newest
# of python3.14 ... python3.9, then python3 or python if one of those. Without
# any, uv (if installed) fetches a Python 3.12 for the bake alone.
HERE=$(cd "$(dirname "$0")" && pwd)
usable() { "$1" -c 'import sys; sys.exit(0 if (3, 9) <= sys.version_info[:2] <= (3, 14) else 1)' >/dev/null 2>&1; }
COMPARE=""
for argument in "$@"; do [ "$argument" = --compare-old ] && COMPARE=1; done
for candidate in "$HERE/.venv/bin/python" python3.14 python3.13 python3.12 python3.11 python3.10 python3.9 python3 python; do
  # --compare-old's Triangle has no package for 3.14
  [ -n "$COMPARE" ] && [ "$candidate" = python3.14 ] && continue
  if command -v "$candidate" >/dev/null 2>&1 && usable "$candidate"; then
    exec "$candidate" "$HERE/launcher.py" "$@"
  fi
done
UV=$(command -v uv || true)
[ -z "$UV" ] && [ -x "$HOME/.local/bin/uv" ] && UV="$HOME/.local/bin/uv"
if [ -n "$UV" ]; then
  echo "halo-psp-bake: no Python 3.9-3.14 here; uv fetches a Python 3.12 for the bake alone"
  PY=$("$UV" python find 3.12 2>/dev/null) || { "$UV" python install 3.12 && PY=$("$UV" python find 3.12); } || exit 1
  exec "$PY" "$HERE/launcher.py" "$@"
fi
echo "halo-psp-bake: the bake needs Python 3.9 to 3.14, and this system has $(python3 --version 2>&1 || echo 'no python3')."
echo "Install one (on macOS: python.org's installer; on Linux: your distribution's python3 and python3-venv),"
echo "or install uv, which fetches one for the bake alone, then run this again:"
echo "    curl -LsSf https://astral.sh/uv/install.sh | sh"
exit 1
