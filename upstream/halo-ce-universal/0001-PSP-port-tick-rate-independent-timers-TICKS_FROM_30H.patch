+matching build is unchanged. REAL_TICKS_FROM_30HZ takes only constants: of a
+variable, it would not fold */
+#define TICKS_FROM_30HZ(n) ((((n) * TICKS_PER_SECOND) + 15) / 30)
+#define REAL_TICKS_FROM_30HZ(x) ((x) * (real)TICKS_PER_SECOND / 30.0f)
