+static void StrictUserCheck(u32 pc, u32 addr, const char *what) {
+	if (!watch_start && getenv("PSP_WATCH")) {
+		sscanf(getenv("PSP_WATCH"), "%x:%x", &watch_start, &watch_end);
+		watch_end += watch_start;
