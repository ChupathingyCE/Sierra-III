+// local patch (Halo PSP port, b107): PSP_COVERAGE=<file> records every
+// compiled block's first address and length (in instructions) once, and
+// rewrites the file as "start count" lines every 1024 new blocks, so which
+// of the game's code ever ran can be told (tools/coverage.py)
+#include <set>
+#include <utility>
+static std::set<std::pair<u32, u32>> coverageBlocks;
+static size_t coverageWritten = 0;
+static void CoverageWrite() {
+	const char *path = getenv("PSP_COVERAGE");
+	if (!path)
+		return;
+	coverageWritten = coverageBlocks.size();
+	FILE *f = fopen(path, "w");
+	if (!f)
+		return;
+	for (auto &e : coverageBlocks)
+		fprintf(f, "%08x %u\n", e.first, e.second);
+	fclose(f);
+}
+static void CoverageRecord(u32 start, u32 count) {
+	static const char *path = getenv("PSP_COVERAGE");
+	static bool registered = false;
+	if (!path)
+		return;
+	if (!registered) {
+		registered = true;
+		atexit(CoverageWrite);
+	}
+	if (!coverageBlocks.insert(std::make_pair(start, count)).second)
+		return;
+	if (coverageBlocks.size() - coverageWritten >= 1024)
+		CoverageWrite();
+}
